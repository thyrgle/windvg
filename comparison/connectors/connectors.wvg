wvg 9 scene 220 170

stroke rail = line (30,110) (190,50) color=#333 width=2
stroke hoop = circle (110,80) 45 color=#333 width=2
fill circle center=intersects rail hoop radius=5 color=#E53935
fill circle center=intersects rail hoop 2 radius=5 color=#43A047
stroke arc_between (40,140) (180,140) deg=90 color=#1E88E5 width=3
stroke arc_between (40,140) (180,140) deg=-60 color=#FDD835 width=2
