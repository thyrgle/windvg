wvg 7 scene 220 170

stroke rail = line p1=(30,110) p2=(190,50) color=#333333 width=2
stroke hoop = circle center=(110,80) radius=45 color=#333333 width=2
fill hit1 = circle center=intersects rail hoop radius=5 color=#E53935
fill hit2 = circle center=intersects rail hoop 2 radius=5 color=#43A047
stroke deck = arc_between p1=(40,140) p2=(180,140) deg=90 color=#1E88E5 width=3
stroke under = arc_between p1=(40,140) p2=(180,140) deg=-60 color=#FDD835 width=2
